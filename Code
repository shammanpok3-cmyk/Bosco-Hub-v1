local configFileName = "BoscoHub_V2_Configs.json"

local function getAllConfigs()
    if not isfile or not readfile then return {} end
    if not isfile(configFileName) then return {} end
    local s, d = pcall(function() return HttpService:JSONDecode(readfile(configFileName)) end)
    return (s and type(d)=="table") and d or {}
end

local function saveConfigsToFile(configs)
    if writefile then pcall(function() writefile(configFileName, HttpService:JSONEncode(configs)) end) end
end

local function saveConfig(name, overwrite)
    local configs = getAllConfigs()
    if configs[name] and not overwrite then return false, "Config exists!" end
    
    local keybindsCopy = {}
    for k, v in pairs(Keybinds) do
        pcall(function() keybindsCopy[k] = {key=v.key.Name, holdMode=v.holdMode, label=v.label} end)
    end
    
    configs[name] = {
        -- Combat
        aimbot = Features.aimbotEnabled,
        aimbotSettings = Features.aimbotSettings,
        silentAim = Features.silentAimEnabled,
        silentAimSettings = Features.silentAimSettings,
        triggerbot = Features.triggerbotEnabled,
        triggerbotSettings = Features.triggerbotSettings,
        flick = Features.flickEnabled,
        flickSettings = Features.flickSettings,
        weaponMods = Features.weaponMods,
        
        -- Movement
        movement = Features.movement,
        pluggwalk = Features.pluggwalkEnabled,
        
        -- Protection
        oobBypass = Features.oobBypassEnabled,
        staffDetector = Features.staffDetectorEnabled,
        
        -- Viewmodel
        viewmodel = Features.viewmodel,
        
        -- Visuals
        esp = Features.espEnabled,
        espSettings = Features.espSettings,
        bulletTrails = Features.bulletTrailsEnabled,
        bulletTrailsColor = Features.bulletTrailsColor,
        crosshair = Features.crosshairEnabled,
        crosshairSettings = Features.crosshairSettings,
        
        -- Camera
        camera = Features.camera,
        
        -- Environment
        lighting = Features.lighting,
        stretchRes = Features.stretchResEnabled,
        stretchResValue = Features.stretchResValue,
        
        -- Unlocker
        unlockAll = Features.unlockAllEnabled,
        skinChanger = Features.skinChangerEnabled,
        
        -- Spoofer
        spoofer = Features.spooferEnabled,
        spooferSettings = Features.spooferSettings,
        
        -- Keybinds
        keybinds = keybindsCopy
    }
    saveConfigsToFile(configs)
    return true, "Saved!"
end

local function loadConfig(name)
    local configs = getAllConfigs()
    local data = configs[name]
    if not data then return false, "Not found!" end
    
    -- Combat
    if data.aimbot ~= nil then Features.setAimbot(data.aimbot) end
    if data.aimbotSettings then for k, v in pairs(data.aimbotSettings) do Features.aimbotSettings[k] = v end end
    
    if data.silentAim ~= nil then Features.setSilentAim(data.silentAim) end
    if data.silentAimSettings then for k, v in pairs(data.silentAimSettings) do Features.silentAimSettings[k] = v end end
    
    if data.triggerbot ~= nil then Features.setTriggerbot(data.triggerbot) end
    if data.triggerbotSettings then for k, v in pairs(data.triggerbotSettings) do Features.triggerbotSettings[k] = v end end
    
    if data.flick ~= nil then Features.setFlick(data.flick) end
    if data.flickSettings then for k, v in pairs(data.flickSettings) do Features.flickSettings[k] = v end end
    
    if data.weaponMods then for k, v in pairs(data.weaponMods) do Features.weaponMods[k] = v end end
    
    -- Movement
    if data.movement then for k, v in pairs(data.movement) do Features.movement[k] = v end end
    if data.pluggwalk ~= nil then Features.setPluggWalk(data.pluggwalk) end
    
    -- Protection
    if data.oobBypass ~= nil then Features.oobBypassEnabled = data.oobBypass end
    if data.staffDetector ~= nil then Features.setStaffDetector(data.staffDetector) end
    
    -- Viewmodel
    if data.viewmodel then for k, v in pairs(data.viewmodel) do Features.viewmodel[k] = v end end
    
    -- Visuals
    if data.esp ~= nil then Features.setESP(data.esp) end
    if data.espSettings then for k, v in pairs(data.espSettings) do Features.espSettings[k] = v; Features.setESPSetting(k, v) end end
    if data.bulletTrails ~= nil then Features.bulletTrailsEnabled = data.bulletTrails end
    if data.bulletTrailsColor then Features.bulletTrailsColor = data.bulletTrailsColor end
    if data.crosshair ~= nil then Features.crosshairEnabled = data.crosshair end
    if data.crosshairSettings then for k, v in pairs(data.crosshairSettings) do Features.crosshairSettings[k] = v end end
    
    -- Camera
    if data.camera then for k, v in pairs(data.camera) do Features.camera[k] = v end end
    
    -- Environment
    if data.lighting then for k, v in pairs(data.lighting) do Features.lighting[k] = v end end
    if data.stretchRes ~= nil then Features.setStretchRes(data.stretchRes) end
    if data.stretchResValue ~= nil then Features.stretchResValue = data.stretchResValue end
    
    -- Unlocker
    if data.unlockAll ~= nil then Features.setUnlockAll(data.unlockAll) end
    if data.skinChanger ~= nil then Features.setSkinChanger(data.skinChanger) end
    
    -- Spoofer
    if data.spoofer ~= nil then Features.setSpoofer(data.spoofer) end
    if data.spooferSettings then for k, v in pairs(data.spooferSettings) do Features.spooferSettings[k] = v end end
    
    -- Keybinds
    if data.keybinds then 
        for k, v in pairs(data.keybinds) do 
            if Keybinds[k] then 
                pcall(function()
                    Keybinds[k].key = Enum.KeyCode[v.key] or Keybinds[k].key
                    Keybinds[k].holdMode = v.holdMode 
                end)
            end 
        end 
    end
    
    return true, "Loaded!"
end

local function deleteConfig(name)
    local configs = getAllConfigs()
    if not configs[name] then return false, "Not found!" end
    configs[name] = nil
    saveConfigsToFile(configs)
    return true, "Deleted!"
end

