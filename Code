    delBtn.BackgroundColor3=Color3.fromRGB(80,10,10)
    delBtn.Font=FONT_MED
    delBtn.TextSize=12
    delBtn.Text="DEL"
    delBtn.TextColor3=C.text
    delBtn.AutoButtonColor=false
    delBtn.Parent=delRow
    mkCorner(delBtn,CR_SM)
    mkStroke(delBtn,C.accent2,0,1)
    delBtn.MouseButton1Click:Connect(function()
        local name=delInput.Text
        if name==""then showToast("Enter config name!")return end
        local success,msg=deleteConfig(name)
        showToast(msg)
    end)
    
    -- Auto Load
    secHead("🔄 Auto Load",lo);lo+=1
    local autoRow=mkRow("Auto Load Config",lo,72);lo+=1
    mkLabel({Parent=autoRow,Text="Auto load on spawn",Font=FONT_MED,TextSize=13,Position=UDim2.fromOffset(0,0),Size=UDim2.new(1,0,0,18)})
    local autoInput=Instance.new("TextBox")
    autoInput.Size=UDim2.fromOffset(120,26)
    autoInput.Position=UDim2.fromOffset(0,24)
    autoInput.PlaceholderText="Config name"
    autoInput.Text=tostring(getAllConfigs()["__autoLoad"] or "")
    autoInput.TextColor3=C.text
    autoInput.BackgroundColor3=C.activeDim
    autoInput.Font=FONT
    autoInput.TextSize=12
    autoInput.BorderSizePixel=0
    autoInput.Parent=autoRow
    mkCorner(autoInput,CR_SM)
    mkStroke(autoInput,C.accent,0,1)
    
    local autoEnabled=false
    local autoToggle=Instance.new("TextButton")
    autoToggle.Size=UDim2.fromOffset(80,26)
    autoToggle.Position=UDim2.new(1,-80,0.5,-13)
    autoToggle.Font=FONT_MED
    autoToggle.TextSize=11
    autoToggle.Text="ENABLE"
    autoToggle.BackgroundColor3=C.toggleOff
    autoToggle.TextColor3=C.text
    autoToggle.AutoButtonColor=false
    autoToggle.Parent=autoRow
    mkCorner(autoToggle,CR_SM)
    
    autoToggle.MouseButton1Click:Connect(function()
        autoEnabled=not autoEnabled
        if autoEnabled then
            autoToggle.Text="ENABLED"
            autoToggle.BackgroundColor3=C.accent
            mkGradient(autoToggle,C.accent,C.accentBrt)
            local configs=getAllConfigs()
            configs["__autoLoadEnabled"]=true
            configs["__autoLoad"]=autoInput.Text
            saveConfigsToFile(configs)
            showToast("Auto-load enabled: "..autoInput.Text)
        else
            autoToggle.Text="ENABLE"
            for _,v in ipairs(autoToggle:GetChildren())do if v:IsA("UIGradient")then v:Destroy()end end
            autoToggle.BackgroundColor3=C.toggleOff
            local configs=getAllConfigs()
            configs["__autoLoadEnabled"]=false
            saveConfigsToFile(configs)
            showToast("Auto-load disabled")
        end
    end)
