                        local wn = self.Name; local wp = self.ClientFighter and self.ClientFighter.Player
                        skinchangerState.constructing_weapon = (wp == LP) and wn or nil
                        if wp == LP and skinchangerState.equipped[wn] then
                            local dk, sk, nk = self:ToEnum("Data"), self:ToEnum("Skin"), self:ToEnum("Name")
                            local skin = skinchangerState.equipped[wn].Skin
                            if skin and vmr then
                                if vmr[dk] then vmr[dk][sk] = skin; vmr[dk][nk] = skin.Name
                                elseif vmr.Data then vmr.Data.Skin = skin; vmr.Data.Name = skin.Name end
                            end
                        end
                        local result = origCVM(self, vmr)
                        skinchangerState.constructing_weapon = nil
                        return result
                    end
                end
            end)
        end)
        
        -- Unlock all cosmetics
        for name, cosmetic in pairs(modules.CosmeticLibrary.Cosmetics) do
            if isNotFinisher(name) then skinchangerState.fake_owned[name] = true end
        end
        
        -- Unlock all weapons
        pcall(function()
            local ownables = modules.ShopLibrary:GetReleasedOwnableWeapons()
            local owned = {}
            local inv = modules.PlayerDataController:Get("WeaponInventory")
            if inv then for _, w in pairs(inv) do if w.Name then owned[w.Name] = true end end end
            for _, wn in pairs(ownables) do
                if not owned[wn] then table.insert(skinchangerState.fake_weapon_owned, {Name = wn, Level = 1, XP = 0}) end
            end
        end)
    end)
end

