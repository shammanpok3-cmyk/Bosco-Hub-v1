Features.triggerbotEnabled = false
Features.triggerbotSettings = { ShootDelay=100, CheckScoped={} }
local triggerbotActive = false
local lastTriggerShot = 0

RunService.Heartbeat:Connect(function()
    if not Features.triggerbotEnabled then
        if triggerbotActive then triggerbotActive = false; modules.MechanicsController:EquippedItemInput("FinishShooting") end
        return
    end
    
    local fighter = modules.FighterController:GetFighter(LP)
    if not fighter or not fighter.EquippedItem then return end
    
    for _, scope in ipairs(Features.triggerbotSettings.CheckScoped) do
        if fighter.EquippedItem.Name == scope and not fighter.EquippedItem:IsFullyAiming() then
            if triggerbotActive then triggerbotActive = false; modules.MechanicsController:EquippedItemInput("FinishShooting") end
            return
        end
    end
    
    local cam = Camera; if not cam then return end
    local center = Vector2.new(cam.ViewportSize.X/2, cam.ViewportSize.Y/2)
    local found = false
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if isTeammate(p) then continue end
        local char = p.Character; if not char then continue end
        local head = char:FindFirstChild("Head"); if not head then continue end
        local hum = char:FindFirstChildOfClass("Humanoid"); if hum and hum.Health <= 0 then continue end
        local sp, on = cam:WorldToViewportPoint(head.Position)
        if on and (Vector2.new(sp.X, sp.Y) - center).Magnitude < 30 then found = true; break end
    end
    
    if not found then
        if triggerbotActive then triggerbotActive = false; modules.MechanicsController:EquippedItemInput("FinishShooting") end
        return
    end
    
    local now = tick()
    if now - lastTriggerShot < Features.triggerbotSettings.ShootDelay / 1000 then return end
    lastTriggerShot = now
    triggerbotActive = true
    modules.MechanicsController:EquippedItemInput("StartShooting")
end)

