    loadMenu.ZIndex=50
    loadMenu.Parent=loadRow
    mkCorner(loadMenu,CR_SM)
    mkStroke(loadMenu,C.accent,0,1)
    local loadMenuList=Instance.new("UIListLayout")
    loadMenuList.SortOrder=Enum.SortOrder.LayoutOrder
    loadMenuList.Parent=loadMenu
    
    local function refreshLoadMenu()
        for _,c in ipairs(loadMenu:GetChildren())do if c:IsA("TextButton")then c:Destroy()end end
        local configs=getAllConfigs()
        local count=0
        for name,_ in pairs(configs)do
            if name:sub(1,2)~="__"then
                count=count+1
                local btn=Instance.new("TextButton")
                btn.Size=UDim2.new(1,0,0,28)
                btn.BackgroundColor3=C.row
                btn.Font=FONT
                btn.TextSize=12
                btn.Text="  "..name
                btn.TextColor3=C.text
                btn.TextXAlignment=Enum.TextXAlignment.Left
                btn.AutoButtonColor=false
                btn.LayoutOrder=count
                btn.Parent=loadMenu
                btn.MouseButton1Click:Connect(function()
                    local success,msg=loadConfig(name)
                    showToast(msg)
                    loadMenu.Visible=false
                end)
            end
        end
        loadMenu.Size=UDim2.fromOffset(200,count*28+4)
    end
    
    loadDropdown.MouseButton1Click:Connect(function()
        refreshLoadMenu()
        loadMenu.Visible=not loadMenu.Visible
    end)
    
    -- Delete Config
    local delRow=mkRow("Delete Config",lo,52);lo+=1
    mkLabel({Parent=delRow,Text="Remove saved config",Font=FONT_MED,TextSize=13,Position=UDim2.fromOffset(0,0),Size=UDim2.new(0.5,0,0,18)})
